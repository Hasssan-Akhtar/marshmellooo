{
  "name": "marshmallow-theme",
  "displayName": "Marshmallow Theme",
  "description": "Code that looks good enough to eat.",
  "version": "0.4.2",
  "publisher": "marshmellow",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#2B2838",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hasssan-Akhtar/marshmellooo"
  },
  "homepage": "https://github.com/Hasssan-Akhtar/marshmellooo#readme",
  "bugs": {
    "url": "https://github.com/Hasssan-Akhtar/marshmellooo/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "pastel",
    "dark",
    "light",
    "marshmallow",
    "cute",
    "customizable",
    "flavours"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "package": "npm run build && npx --yes @vscode/vsce package",
    "images": "node scripts/images.js",
    "publish:vsce": "npx --yes @vscode/vsce publish",
    "publish:ovsx": "npx --yes ovsx publish"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marshmallow",
          "title": "Marshmallow",
          "icon": "media/marshmallow.svg"
        }
      ]
    },
    "views": {
      "marshmallow": [
        {
          "type": "webview",
          "id": "marshmallow.flavours",
          "name": "Flavours"
        }
      ]
    },
    "commands": [
      {
        "command": "marshmallow.pick",
        "title": "Marshmallow: Pick a Flavour",
        "icon": "$(symbol-color)"
      },
      {
        "command": "marshmallow.toggleMode",
        "title": "Marshmallow: Toggle Night/Day",
        "icon": "$(color-mode)"
      },
      {
        "command": "marshmallow.surprise",
        "title": "Marshmallow: Surprise Me",
        "icon": "$(sparkle)"
      },
      {
        "command": "marshmallow.pinToProject",
        "title": "Marshmallow: Pin Flavour to This Project",
        "icon": "$(pin)"
      },
      {
        "command": "marshmallow.unpinFromProject",
        "title": "Marshmallow: Unpin Flavour from This Project",
        "icon": "$(pinned)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "marshmallow.toggleMode",
          "when": "view == marshmallow.flavours",
          "group": "navigation@1"
        },
        {
          "command": "marshmallow.surprise",
          "when": "view == marshmallow.flavours",
          "group": "navigation@2"
        }
      ]
    },
    "themes": [
      {
        "label": "Marshmallow Night",
        "uiTheme": "vs-dark",
        "path": "./themes/marshmallow-night-color-theme.json"
      },
      {
        "label": "Marshmallow Day",
        "uiTheme": "vs",
        "path": "./themes/marshmallow-day-color-theme.json"
      },
      {
        "label": "Bubblegum Night",
        "uiTheme": "vs-dark",
        "path": "./themes/bubblegum-night-color-theme.json"
      },
      {
        "label": "Bubblegum Day",
        "uiTheme": "vs",
        "path": "./themes/bubblegum-day-color-theme.json"
      },
      {
        "label": "Mint Chip Night",
        "uiTheme": "vs-dark",
        "path": "./themes/mint-chip-night-color-theme.json"
      },
      {
        "label": "Mint Chip Day",
        "uiTheme": "vs",
        "path": "./themes/mint-chip-day-color-theme.json"
      },
      {
        "label": "Peach Cobbler Night",
        "uiTheme": "vs-dark",
        "path": "./themes/peach-cobbler-night-color-theme.json"
      },
      {
        "label": "Peach Cobbler Day",
        "uiTheme": "vs",
        "path": "./themes/peach-cobbler-day-color-theme.json"
      },
      {
        "label": "Blueberry Pie Night",
        "uiTheme": "vs-dark",
        "path": "./themes/blueberry-pie-night-color-theme.json"
      },
      {
        "label": "Blueberry Pie Day",
        "uiTheme": "vs",
        "path": "./themes/blueberry-pie-day-color-theme.json"
      },
      {
        "label": "Matcha Latte Night",
        "uiTheme": "vs-dark",
        "path": "./themes/matcha-latte-night-color-theme.json"
      },
      {
        "label": "Matcha Latte Day",
        "uiTheme": "vs",
        "path": "./themes/matcha-latte-day-color-theme.json"
      },
      {
        "label": "Lemon Drop Night",
        "uiTheme": "vs-dark",
        "path": "./themes/lemon-drop-night-color-theme.json"
      },
      {
        "label": "Lemon Drop Day",
        "uiTheme": "vs",
        "path": "./themes/lemon-drop-day-color-theme.json"
      },
      {
        "label": "Cotton Candy Night",
        "uiTheme": "vs-dark",
        "path": "./themes/cotton-candy-night-color-theme.json"
      },
      {
        "label": "Cotton Candy Day",
        "uiTheme": "vs",
        "path": "./themes/cotton-candy-day-color-theme.json"
      },
      {
        "label": "Sea Glass Night",
        "uiTheme": "vs-dark",
        "path": "./themes/sea-glass-night-color-theme.json"
      },
      {
        "label": "Sea Glass Day",
        "uiTheme": "vs",
        "path": "./themes/sea-glass-day-color-theme.json"
      },
      {
        "label": "Cherry Cola Night",
        "uiTheme": "vs-dark",
        "path": "./themes/cherry-cola-night-color-theme.json"
      },
      {
        "label": "Cherry Cola Day",
        "uiTheme": "vs",
        "path": "./themes/cherry-cola-day-color-theme.json"
      },
      {
        "label": "Marshmallow Custom 1 Night",
        "uiTheme": "vs-dark",
        "path": "./themes/marshmallow-custom-1-night-color-theme.json"
      },
      {
        "label": "Marshmallow Custom 1 Day",
        "uiTheme": "vs",
        "path": "./themes/marshmallow-custom-1-day-color-theme.json"
      },
      {
        "label": "Marshmallow Custom 2 Night",
        "uiTheme": "vs-dark",
        "path": "./themes/marshmallow-custom-2-night-color-theme.json"
      },
      {
        "label": "Marshmallow Custom 2 Day",
        "uiTheme": "vs",
        "path": "./themes/marshmallow-custom-2-day-color-theme.json"
      },
      {
        "label": "Marshmallow Custom 3 Night",
        "uiTheme": "vs-dark",
        "path": "./themes/marshmallow-custom-3-night-color-theme.json"
      },
      {
        "label": "Marshmallow Custom 3 Day",
        "uiTheme": "vs",
        "path": "./themes/marshmallow-custom-3-day-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Marshmallow",
      "properties": {
        "marshmallow.personality": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "Give each flavour its own cursor and spacing. Turning this off restores your previous `editor.cursor*`, `editor.lineHeight` and `editor.letterSpacing` settings."
        },
        "marshmallow.followTheSun": {
          "type": "string",
          "enum": [
            "off",
            "system",
            "time"
          ],
          "enumDescriptions": [
            "Never switch between Night and Day automatically.",
            "Match your operating system's light/dark appearance.",
            "Switch at the times set below."
          ],
          "default": "off",
          "order": 2,
          "description": "Switch the active flavour between Night and Day automatically."
        },
        "marshmallow.dayStartsAt": {
          "type": "string",
          "default": "07:00",
          "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "Use 24-hour HH:MM, e.g. 07:00",
          "order": 3,
          "markdownDescription": "When **Follow the Sun** is , switch to Day at this time (24-hour HH:MM)."
        },
        "marshmallow.nightStartsAt": {
          "type": "string",
          "default": "19:00",
          "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "Use 24-hour HH:MM, e.g. 19:00",
          "order": 4,
          "markdownDescription": "When **Follow the Sun** is , switch to Night at this time (24-hour HH:MM)."
        },
        "marshmallow.flavourOfTheDay": {
          "type": "boolean",
          "default": false,
          "order": 5,
          "description": "Open VS Code in a random flavour each day. Projects with a pinned flavour keep theirs."
        },
        "marshmallow.statusBar": {
          "type": "boolean",
          "default": true,
          "order": 6,
          "description": "Show the active flavour in the status bar. Click it to pick another."
        }
      }
    }
  }
}
