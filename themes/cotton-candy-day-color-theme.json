    "panel.border": "#E5DEEC",
    "panelTitle.activeForeground": "#34283D",
    "panelTitle.inactiveForeground": "#887A93",
    "panelTitle.activeBorder": "#9D56AD",
    "terminal.background": "#F6F1FA",
    "terminal.foreground": "#34283D",
    "terminalCursor.foreground": "#9D56AD",
    "terminal.selectionBackground": "#E3E0FFCC",
