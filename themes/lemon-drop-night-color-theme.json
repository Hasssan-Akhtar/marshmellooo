    "button.secondaryBackground": "#433A1A",
    "button.secondaryForeground": "#EFEBDE",
    "checkbox.background": "#232016",
    "checkbox.border": "#38352A",
    "badge.background": "#6BD8DE",
    "badge.foreground": "#29261B",
    "progressBar.background": "#D8C477",
    "panel.background": "#232016",
    "panel.border": "#38352A",
    "panelTitle.activeForeground": "#EFEBDE",
    "panelTitle.inactiveForeground": "#9C957D",
    "panelTitle.activeBorder": "#D8C477",
    "terminal.background": "#232016",
    "terminal.foreground": "#EFEBDE",
    "terminalCursor.foreground": "#D8C477",
    "terminal.selectionBackground": "#4E420DCC",
    "terminal.ansiBlack": "#1D1B10",
    "terminal.ansiRed": "#F39098",
    "terminal.ansiGreen": "#95DFA4",
