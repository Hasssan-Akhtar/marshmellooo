    "quickInputList.focusBackground": "#4D446B",
    "quickInputList.focusForeground": "#FFFFFF",
    "pickerGroup.foreground": "#FFB3D1",
    "pickerGroup.border": "#4A4362",
    "input.background": "#252230",
    "input.foreground": "#EDE6F5",
    "input.border": "#3A3548",
    "input.placeholderForeground": "#8E84A8",
    "inputOption.activeBorder": "#FFB3D1",
    "inputOption.activeBackground": "#FFB3D133",
    "inputValidation.errorBorder": "#FF7A93",
    "inputValidation.warningBorder": "#FFC97A",
    "dropdown.background": "#252230",
    "dropdown.border": "#3A3548",
    "dropdown.foreground": "#EDE6F5",
    "button.background": "#FFB3D1",
    "button.foreground": "#2B2838",
    "button.hoverBackground": "#FFB3D1D9",
    "button.secondaryBackground": "#3A3450",
    "button.secondaryForeground": "#EDE6F5",
    "checkbox.background": "#252230",
    "checkbox.border": "#3A3548",
    "badge.background": "#C7A8FF",
    "badge.foreground": "#2B2838",
    "progressBar.background": "#FFB3D1",
    "panel.background": "#252230",
    "panel.border": "#3A3548",
    "panelTitle.activeForeground": "#EDE6F5",
    "panelTitle.inactiveForeground": "#8E84A8",
    "panelTitle.activeBorder": "#FFB3D1",
    "terminal.background": "#252230",
    "terminal.foreground": "#EDE6F5",
    "terminalCursor.foreground": "#FFB3D1",
    "terminal.selectionBackground": "#4D446BCC",
    "terminal.ansiBlack": "#1F1C28",
    "terminal.ansiRed": "#FF8FA3",
    "terminal.ansiGreen": "#A8E6B8",
    "terminal.ansiYellow": "#FFE08F",
    "terminal.ansiBlue": "#8FD3FF",
    "terminal.ansiMagenta": "#FF9EC7",
    "terminal.ansiCyan": "#9FE7E0",
    "terminal.ansiWhite": "#CFC6E2",
    "terminal.ansiBrightBlack": "#7D7396",
    "terminal.ansiBrightRed": "#FF8FA3",
    "terminal.ansiBrightGreen": "#A8E6B8",
    "terminal.ansiBrightYellow": "#FFE08F",
    "terminal.ansiBrightBlue": "#8FD3FF",
    "terminal.ansiBrightMagenta": "#FF9EC7",
    "terminal.ansiBrightCyan": "#9FE7E0",
    "terminal.ansiBrightWhite": "#FFFFFF",
