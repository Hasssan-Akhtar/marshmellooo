    "statusBar.foreground": "#2B2838",
    "statusBar.border": "#FFB3D1",
    "statusBar.noFolderBackground": "#C7A8FF",
    "statusBar.noFolderForeground": "#2B2838",
    "statusBar.debuggingBackground": "#FFC97A",
    "statusBar.debuggingForeground": "#2B2838",
    "statusBarItem.remoteBackground": "#C7A8FF",
    "statusBarItem.remoteForeground": "#2B2838",
    "statusBarItem.hoverBackground": "#2B28381F",
    "notifications.background": "#2F2B3D",
    "notifications.foreground": "#EDE6F5",
    "notifications.border": "#4A4362",
    "notificationCenterHeader.background": "#252230",
    "notificationsErrorIcon.foreground": "#FF7A93",
    "notificationsWarningIcon.foreground": "#FFC97A",
