    "statusBar.noFolderForeground": "#31212A",
    "statusBar.debuggingBackground": "#F8BF6C",
    "statusBar.debuggingForeground": "#31212A",
    "statusBarItem.remoteBackground": "#F9B189",
    "statusBarItem.remoteForeground": "#31212A",
    "statusBarItem.hoverBackground": "#31212A1F",
    "notifications.background": "#3C2A34",
    "notifications.foreground": "#F5E7EE",
    "notifications.border": "#4E3C46",
    "notificationCenterHeader.background": "#2B1B24",
    "notificationsErrorIcon.foreground": "#F06F84",
    "notificationsWarningIcon.foreground": "#F8BF6C",
    "notificationsInfoIcon.foreground": "#6DD6E8",
