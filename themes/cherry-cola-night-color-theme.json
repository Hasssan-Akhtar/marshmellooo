    "inputOption.activeBorder": "#E5AEE8",
    "inputOption.activeBackground": "#E5AEE833",
    "inputValidation.errorBorder": "#F06F84",
    "inputValidation.warningBorder": "#F8BF6C",
    "dropdown.background": "#2B1B24",
    "dropdown.border": "#412F39",
    "dropdown.foreground": "#F5E7EE",
    "button.background": "#E5AEE8",
    "button.foreground": "#31212A",
    "button.hoverBackground": "#E5AEE8D9",
    "button.secondaryBackground": "#4D3040",
    "button.secondaryForeground": "#F5E7EE",
    "checkbox.background": "#2B1B24",
    "checkbox.border": "#412F39",
    "badge.background": "#F9B189",
    "badge.foreground": "#31212A",
    "progressBar.background": "#E5AEE8",
    "panel.background": "#2B1B24",
    "panel.border": "#412F39",
    "panelTitle.activeForeground": "#F5E7EE",
    "panelTitle.inactiveForeground": "#A68D9A",
    "panelTitle.activeBorder": "#E5AEE8",
    "terminal.background": "#2B1B24",
    "terminal.foreground": "#F5E7EE",
    "terminalCursor.foreground": "#E5AEE8",
    "terminal.selectionBackground": "#5C324BCC",
    "terminal.ansiBlack": "#25151E",
    "terminal.ansiRed": "#F39098",
    "terminal.ansiGreen": "#95DFA4",
    "terminal.ansiYellow": "#EED780",
    "terminal.ansiBlue": "#7AC8F5",
    "terminal.ansiMagenta": "#F89DC9",
    "terminal.ansiCyan": "#90E2E1",
    "terminal.ansiWhite": "#DECBD5",
    "terminal.ansiBrightBlack": "#927786",
    "terminal.ansiBrightRed": "#F39098",
    "terminal.ansiBrightGreen": "#95DFA4",
    "terminal.ansiBrightYellow": "#EED780",
    "terminal.ansiBrightBlue": "#7AC8F5",
