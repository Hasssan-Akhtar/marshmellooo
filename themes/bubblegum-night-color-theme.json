    "checkbox.background": "#2A1B25",
    "checkbox.border": "#402F3A",
    "badge.background": "#CEB6FC",
    "badge.foreground": "#31212B",
    "progressBar.background": "#EDACDE",
    "panel.background": "#2A1B25",
    "panel.border": "#402F3A",
    "panelTitle.activeForeground": "#F4E7EF",
    "panelTitle.inactiveForeground": "#A58D9C",
    "panelTitle.activeBorder": "#EDACDE",
    "terminal.background": "#2A1B25",
    "terminal.foreground": "#F4E7EF",
    "terminalCursor.foreground": "#EDACDE",
    "terminal.selectionBackground": "#5B334ECC",
    "terminal.ansiBlack": "#24151F",
    "terminal.ansiRed": "#F39098",
    "terminal.ansiGreen": "#95DFA4",
