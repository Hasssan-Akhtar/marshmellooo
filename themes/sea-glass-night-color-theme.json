    "panelTitle.inactiveForeground": "#7D9BA3",
    "panelTitle.activeBorder": "#6BD8DE",
    "terminal.background": "#0E2429",
    "terminal.foreground": "#DEEFF3",
    "terminalCursor.foreground": "#6BD8DE",
    "terminal.selectionBackground": "#004B59CC",
    "terminal.ansiBlack": "#071E23",
    "terminal.ansiRed": "#F39098",
    "terminal.ansiGreen": "#95DFA4",
