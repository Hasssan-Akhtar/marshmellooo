    "badge.foreground": "#342E15",
    "progressBar.background": "#937400",
    "panel.background": "#F6F4EB",
    "panel.border": "#E5E1D3",
    "panelTitle.activeForeground": "#342E15",
    "panelTitle.inactiveForeground": "#878065",
    "panelTitle.activeBorder": "#937400",
    "terminal.background": "#F6F4EB",
    "terminal.foreground": "#342E15",
    "terminalCursor.foreground": "#937400",
    "terminal.selectionBackground": "#ECDDFFCC",
    "terminal.ansiBlack": "#342E15",
    "terminal.ansiRed": "#C73751",
    "terminal.ansiGreen": "#2A904B",
    "terminal.ansiYellow": "#A87600",
    "terminal.ansiBlue": "#007CBD",
