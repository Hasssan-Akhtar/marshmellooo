    "quickInputList.focusForeground": "#12333A",
    "pickerGroup.foreground": "#008F9A",
    "pickerGroup.border": "#D0E2E6",
    "input.background": "#EBF6F8",
    "input.foreground": "#12333A",
    "input.border": "#D3E5EA",
    "input.placeholderForeground": "#65878F",
    "inputOption.activeBorder": "#008F9A",
    "inputOption.activeBackground": "#008F9A33",
    "inputValidation.errorBorder": "#D63053",
    "inputValidation.warningBorder": "#D28500",
    "dropdown.background": "#EBF6F8",
